# 复制为私有文件并替换全部值；不要提交实际 Secret。密码中的 URL 保留字符需百分号编码。
apiVersion: v1
kind: Secret
metadata:
  name: rag-e-secrets
  namespace: rag-e
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_WITH_RANDOM_PASSWORD
  RAGE_DATABASE_URL: postgresql+psycopg://rage:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/rage
  RAGE_JWT_SECRET: REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
  RAGE_ADMIN_PASSWORD: REPLACE_WITH_PRIVATE_ADMIN_PASSWORD
  RAGE_LLM_API_KEY: REPLACE_WITH_PROVIDER_KEY
  RAGE_EMBEDDING_API_KEY: REPLACE_WITH_EMBEDDING_KEY
  RAGE_RERANK_API_KEY: REPLACE_WITH_SILICONFLOW_KEY
  RAGE_TAVILY_API_KEY: ""
  RAGE_EXA_API_KEY: ""
  RAGE_VISION_API_KEY: ""
  RAGE_CONTEXT_COUNT_API_KEY: ""
  RAGE_MILVUS_TOKEN: ""
  RAGE_NEO4J_PASSWORD: REPLACE_WITH_NEO4J_PASSWORD
  NEO4J_AUTH: neo4j/REPLACE_WITH_NEO4J_PASSWORD
  RAGE_METRICS_TOKEN: REPLACE_WITH_MONITORING_TOKEN
  RAGE_LANGFUSE_PUBLIC_KEY: ""
  RAGE_LANGFUSE_SECRET_KEY: ""
  RAGE_MODERATION_API_KEY: ""
