# Copy to .env.production; keep private credentials outside version control.
# RAG algorithm settings are shared with evaluation and must not be repeated here.
RAGE_PIPELINE_PROFILE=config/rag.production.json
RAGE_ENVIRONMENT=production
RAGE_AUTO_MIGRATE=false

# Same providers/models as evaluation; deploy-specific keys are allowed.
RAGE_LLM_API_KEY=
RAGE_MODERATION_API_KEY=
RAGE_EMBEDDING_API_KEY=
RAGE_RERANK_API_KEY=
# Optional web search keys; enable/select providers in the shared JSON.
RAGE_TAVILY_API_KEY=
RAGE_EXA_API_KEY=
# Memory/compaction algorithm fields live in the shared JSON; deployment-specific meter and worker settings here.
RAGE_CONTEXT_TOKENIZER_PATH=
RAGE_CONTEXT_COUNT_URL=
RAGE_CONTEXT_COUNT_API_KEY=
RAGE_CONTEXT_COUNT_TIMEOUT=10
RAGE_MEMORY_WORKER_ENABLED=true
RAGE_MEMORY_IDLE_SECONDS=300
RAGE_MEMORY_WORKER_INTERVAL=10
RAGE_MEMORY_JOB_TIMEOUT=120
RAGE_MEMORY_JOB_ATTEMPTS=3

# Optional multimodal attachments; independent from the text-only evaluation profile.
RAGE_VISION_BASE_URL=https://api.openai.com/v1
RAGE_VISION_MODEL=
RAGE_VISION_API_KEY=
RAGE_VISION_TIMEOUT=45
RAGE_VISION_MAX_CONCURRENCY=2
RAGE_ATTACHMENT_SPACE_BYTES=104857600
RAGE_ATTACHMENT_MAX_FILES=100
RAGE_ATTACHMENT_MAX_PER_MESSAGE=4
RAGE_ATTACHMENT_MAX_CHARS=24000
RAGE_ATTACHMENT_MAX_IMAGES=12

# Production infrastructure; replace domain and trusted proxy networks before use.
RAGE_PUBLIC_ORIGIN=https://rag.example.com
RAGE_CORS_ORIGINS=["https://rag.example.com"]
RAGE_TRUSTED_PROXY_HOSTS=[]
RAGE_DATABASE_URL=postgresql+psycopg://rage:CHANGE_ME@postgres:5432/rage
POSTGRES_PASSWORD=CHANGE_ME
RAGE_REDIS_URL=redis://redis:6379/0
RAGE_MILVUS_URI=http://milvus:19530
RAGE_MILVUS_TOKEN=
RAGE_MILVUS_COLLECTION=rag_e_production_v1
RAGE_NEO4J_URI=bolt://neo4j:7687
RAGE_NEO4J_USERNAME=neo4j
RAGE_NEO4J_PASSWORD=
RAGE_NEO4J_DATABASE=neo4j
RAGE_KNOWLEDGE_NAMESPACE=production_v1
RAGE_ENCRYPTION_KEY_FILE=/app/.secrets/keyring.json
RAGE_JWT_SECRET=
RAGE_ADMIN_USERNAME=admin
RAGE_ADMIN_PASSWORD=
RAGE_METRICS_TOKEN=
RAGE_ALLOW_REGISTRATION=false
RAGE_LANGFUSE_ENABLED=false
RAGE_TRACE_CAPTURE_CONTENT=false
MINIO_ROOT_PASSWORD=
