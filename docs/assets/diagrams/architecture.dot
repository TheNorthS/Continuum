digraph G {

  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.38, ranksep=0.48, splines=polyline,
         fontname="Microsoft YaHei", fontsize=22, fontcolor="#0F172A", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#CBD5E1",
        fontname="Microsoft YaHei", fontsize=13, fontcolor="#0F172A", margin="0.20,0.15", penwidth=1.3];
  edge [color="#94A3B8", penwidth=1.35, arrowsize=0.7, fontname="Microsoft YaHei", fontsize=10, fontcolor="#475569"];

  label="知恒 · Continuum\n知识与记忆双驱动的长程多模态智能体平台\n ";
  ui [label="React + TypeScript 工作台\n聊天 / 知识库 / 私人附件空间 / 记忆管理 / 图谱 / 监控", fillcolor="#EFF6FF", color="#60A5FA", width=8.0];
  api [label="FastAPI · 身份与资源边界\nJWT + 请求签名 / RBAC + 知识库 ACL / 会话与附件归属", fillcolor="#DBEAFE", color="#3B82F6", width=8.0];
  chat [label="ChatService + Orchestrator（LangGraph）\n会话租约 / 内容审查 / 路由 / 生成 / Grounding 反馈修正 / 最终提交", fillcolor="#F1F5F9", color="#64748B", width=8.0];
  ui -> api [label="签名 HTTP / SSE"]; api -> chat;
  subgraph cluster_sources {
    label="在线问答 · 按用户范围组合"; labeljust=l; fontsize=14; fontcolor="#475569";
    color="#E2E8F0"; style="rounded"; margin=18;
    knowledge [label="知识库检索\n章节 / 语义分块 → Embedding\nBM25 + 稠密向量 + 可选图谱\nRRF → 模型精排 → Top-K", fillcolor="#ECFDF5", color="#34D399", width=3.4];
    context [label="ContextService · 工作上下文\n原始事件 → 引用裁剪 → 最近原文\nToken 预算 / 增量摘要 / CAS 检查点\n注入个人记忆前后复核来源", fillcolor="#EFF6FF", color="#60A5FA", width=3.6];
    attachment [label="AttachmentService + VisionService\n图片 / PDF / DOCX / TXT / Markdown\n正文 + 独立视觉模型 → 文字证据\n原文件加密保存；附件不向量化", fillcolor="#F5F3FF", color="#A78BFA", width=3.6];
    {rank=same; knowledge; context; attachment;}
  }
  chat -> knowledge; chat -> context; chat -> attachment;
  index [label="知识索引与缓存\nMilvus HNSW + BM25 / 开发本地索引\nNeo4j 可选 / L1 + Redis L2", fillcolor="#ECFDF5", color="#34D399", width=3.4];
  memory [label="MemoryService · 后台个人记忆\nSQL 持久队列 / 租约 / 重试\n原始证据 → 候选 → 去重与冲突\nExact + BM25 + Vector / RRF / MMR", fillcolor="#FFF7ED", color="#FDBA74", width=3.6];
  models [label="外部模型与搜索适配\n主 LLM / Embedding / Rerank\n独立 Vision / 可选 Token 计数接口\nTavily + Exa（受联网范围约束）", fillcolor="#F5F3FF", color="#A78BFA", width=3.6];
  {rank=same; index; memory; models;}
  knowledge -> index; context -> memory [label="相关记忆检索"]; attachment -> models [label="按需识别"];
  chat -> models [style=dashed, constraint=false, label="主模型与可选网络"];
  sql [shape=cylinder, label="PostgreSQL（生产） / SQLite（开发）· 业务权威存储\n账号与授权 / 文档与会话 / 加密附件 / 事件与原始证据 / 检查点 / 记忆、候选与任务\n记忆向量在经授权的 SQL 集合上搜索，不混入知识库 Milvus collection", fillcolor="#F8FAFC", color="#64748B", width=10.8];
  index -> sql [label="文档状态与权限"]; memory -> sql [label="两阶段提炼与版本提交"];
  models -> sql [style=invis]; context -> sql [constraint=false, label="事件与检查点"];
  attachment -> sql [constraint=false, label="加密文件"];
  obs [label="共用工程基础\nHTTP 连接池 / 有界并发 / AES-GCM / 脱敏审计\nPrometheus / p50·p95·p99 / 告警状态机 / 可选 Langfuse", fillcolor="#F1F5F9", color="#94A3B8", width=10.8];
  sql -> obs [style=dashed, arrowhead=none, label="观测覆盖应用调用链；图中省略重复连接"];
}
