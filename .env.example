# 所有配置只从 RAG-E/.env 和 RAGE_ 环境变量读取，不读取父项目凭据。
# 默认是可离线运行的演示模式；真实模型模式见 docs/QUICKSTART.md。
RAGE_ENVIRONMENT=development
RAGE_MODE=demo
RAGE_AUTO_MIGRATE=true
RAGE_ADMIN_USERNAME=admin
RAGE_ADMIN_PASSWORD=rag-e-demo-2026
RAGE_JWT_SECRET=local-demo-only-change-before-deploy-2026
RAGE_ALLOW_REGISTRATION=false
RAGE_PUBLIC_ORIGIN=http://localhost:5173
# 本地开发自动生成 .secrets/keyring.json；生产必须单独挂载，绝不可放在镜像/Git/数据库备份内。
# RAGE_ENCRYPTION_KEY_FILE=/run/secrets/rag-e-keyring.json
RAGE_PROOF_WINDOW_SECONDS=60
RAGE_SESSION_HOURS=24
RAGE_TRUSTED_PROXY_HOSTS=[]
RAGE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 省略数据库地址时，数据库固定保存在 RAG-E/data/rag_e.db。
# RAGE_DATABASE_URL=postgresql+psycopg://rage:password@localhost:5432/rage
RAGE_LLM_BASE_URL=https://api.openai.com/v1
RAGE_LLM_API_KEY=
RAGE_LLM_MODEL=
# 支持 thinking 参数的服务（如 DeepSeek）可显式设置 disabled；其他服务保留 default。
RAGE_LLM_THINKING=default
RAGE_EMBEDDING_PROVIDER=hash
RAGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAGE_EMBEDDING_DIMENSION=512
RAGE_EMBEDDING_DEVICE=cpu
RAGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAGE_EMBEDDING_API_KEY=
RAGE_VECTOR_BACKEND=local
RAGE_MILVUS_URI=http://localhost:19530
RAGE_MILVUS_COLLECTION=rag_e_chunks
RAGE_MILVUS_TOKEN=
RAGE_MILVUS_HNSW_M=16
RAGE_MILVUS_HNSW_EF_CONSTRUCTION=128
RAGE_MILVUS_HNSW_EF=128
# 模型精排：none 保持无模型依赖的演示；huggingface 为本地 CrossEncoder；api 为专用 rerank 接口。
RAGE_RERANK_PROVIDER=none
RAGE_RERANK_MODEL=BAAI/bge-reranker-base
RAGE_RERANK_REVISION=
RAGE_RERANK_DEVICE=cpu
# 先单独下载模型，默认请求期间不联网拉取权重。
RAGE_RERANK_LOCAL_FILES_ONLY=true
# 完整 URL（如 https://your-provider.example/v1/rerank），不复用 LLM/Embedding 密钥。
RAGE_RERANK_API_URL=
RAGE_RERANK_API_FORMAT=standard
RAGE_RERANK_API_KEY=
RAGE_RERANK_CANDIDATES=32
RAGE_RERANK_BATCH_SIZE=8
RAGE_RERANK_MAX_CONCURRENCY=2
RAGE_RERANK_MAX_LENGTH=512
RAGE_RERANK_QUERY_MAX_CHARS=1000
RAGE_RERANK_DOCUMENT_MAX_CHARS=6000
RAGE_RERANK_TIMEOUT=30
# 可选 0..1 相关性阈值；不设置时保留所有候选参与 Top-K 排序。
# RAGE_RERANK_MIN_SCORE=0.2
RAGE_RERANK_FAILURE_MODE=error
RAGE_WEB_SEARCH_ENABLED=false
RAGE_TAVILY_API_KEY=
RAGE_REDIS_URL=
RAGE_KNOWLEDGE_DOMAIN=用户上传的各领域专业资料，优先知识库检索
RAGE_KNOWLEDGE_NAMESPACE=default
RAGE_GRAPH_ENABLED=false
RAGE_NEO4J_URI=bolt://localhost:7687
RAGE_NEO4J_USERNAME=neo4j
RAGE_NEO4J_PASSWORD=
RAGE_NEO4J_DATABASE=neo4j
RAGE_NEO4J_POOL_SIZE=16
RAGE_GRAPH_EXTRACT_MAX_CHUNKS=200
RAGE_GRAPH_RETRIEVAL_HOPS=2
RAGE_LLM_MAX_CONNECTIONS=32
RAGE_LLM_MAX_CONCURRENCY=8
RAGE_LLM_BATCH_SIZE=32
RAGE_CACHE_L1_SIZE=256
RAGE_CACHE_L1_TTL=10
RAGE_PROFILER_WINDOW=300
RAGE_PROFILER_SAMPLES=2000
RAGE_ALERT_INTERVAL=5
RAGE_ALERT_FOR_SECONDS=30
RAGE_ALERT_MIN_SAMPLES=5
RAGE_ALERT_ERROR_RATE=0.2
RAGE_ALERT_P95_SECONDS=20
RAGE_ALERT_LOOP_LAG_SECONDS=0.2
RAGE_METRICS_TOKEN=
RAGE_LANGFUSE_ENABLED=false
RAGE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
RAGE_LANGFUSE_PUBLIC_KEY=
RAGE_LANGFUSE_SECRET_KEY=
# 默认仅导出耗时、模型、任务和 token 等元数据；开启后才发送问题、文档和回答内容。
RAGE_TRACE_CAPTURE_CONTENT=false
RAGE_SEMANTIC_CHUNKING=true
RAGE_CHUNK_SIZE=1500
RAGE_CHUNK_OVERLAP=150
RAGE_MAX_REWRITES=2
RAGE_MAX_GENERATIONS=2
# 内容安全审查始终开启。auto: demo 使用规则，live 使用规则+独立语义分类。
RAGE_MODERATION_BACKEND=auto
# 默认复用 LLM 的模型/地址/密钥；可填独立分类模型。
RAGE_MODERATION_MODEL=
RAGE_MODERATION_THINKING=default
RAGE_MODERATION_BASE_URL=
RAGE_MODERATION_API_KEY=
RAGE_MODERATION_TIMEOUT=12
RAGE_MODERATION_CHECK_TIMEOUT=35
RAGE_MODERATION_MAX_CONCURRENCY=4
RAGE_MODERATION_CHUNK_CHARS=12000
RAGE_MODERATION_MAX_CHARS=200000
RAGE_MODERATION_THRESHOLDS={"violence":0.8,"hate":0.8,"harassment":0.8,"sexual_minors":0.5,"sexual_explicit":0.8,"self_harm":0.5,"illicit_instructions":0.8,"cyber_abuse":0.8}
# Docker Compose 内部数据库/对象存储密码。正式部署务必设置独立值。
POSTGRES_PASSWORD=rag-e-local-postgres
MINIO_ROOT_PASSWORD=rag-e-local-minio
