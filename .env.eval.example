# Production and evaluation share all model/chunk/retrieval policies in this file.
RAGE_PIPELINE_PROFILE=config/rag.production.json
RAGE_ENVIRONMENT=test

# Model credentials only. Keep the settings for each provider together.
# DeepSeek: generation, relevance/grounding, and moderation
RAGE_LLM_API_KEY=
RAGE_MODERATION_API_KEY=
# OpenAI: text-embedding-3-small
RAGE_EMBEDDING_API_KEY=
# SiliconFlow: Qwen/Qwen3-Reranker-0.6B
RAGE_RERANK_API_KEY=

# Isolated evaluation infrastructure. Collection/namespace are generated per run.
RAGE_MILVUS_URI=http://127.0.0.1:19539
RAGE_MILVUS_TOKEN=
RAGE_NEO4J_URI=bolt://127.0.0.1:17687
RAGE_NEO4J_USERNAME=neo4j
RAGE_NEO4J_PASSWORD=
RAGE_NEO4J_DATABASE=neo4j
RAGE_REDIS_URL=redis://127.0.0.1:16379/2
RAGE_LANGFUSE_ENABLED=false
RAGE_TRACE_CAPTURE_CONTENT=false

# Separate evaluation accounts; application data/keys remain isolated by the runner.
RAGE_ADMIN_USERNAME=evaladmin
RAGE_ADMIN_PASSWORD=rag-e-evaluation-2026
